FROM registry.redhat.io/ubi9/python-312@sha256:e80ff3673c95b91f0dafdbe97afb261eab8244d7fd8b47e20ffcbcfee27fb168

ARG EMBED_MODEL_ID=ibm-granite/granite-embedding-125m-english

USER root

# 1. Clean yum cache immediately to prevent layer bloat
RUN yum install -y mesa-libGL \
    && yum clean all \
    && rm -rf /var/cache/yum

# model dirs; group 0 + g+rwX so openshift arbitrary uid can read/write
RUN mkdir -p /opt/app-root/model-cache/docling \
    /opt/app-root/model-cache/huggingface \
    /opt/app-root/model-cache/sentence-transformers \
    /opt/app-root/model-cache/rapidocr \
    && chown -R 1001:0 /opt/app-root/model-cache \
    && chmod -R g+rwX /opt/app-root/model-cache

USER 1001

ENV HF_HOME=/opt/app-root/model-cache/huggingface
ENV TRANSFORMERS_CACHE=/opt/app-root/model-cache/huggingface
ENV HUGGINGFACE_HUB_CACHE=/opt/app-root/model-cache/huggingface
ENV SENTENCE_TRANSFORMERS_HOME=/opt/app-root/model-cache/sentence-transformers
ENV RAPIDOCR_MODEL_DIR=/opt/app-root/model-cache/rapidocr
ENV DOCLING_ARTIFACTS_PATH=/opt/app-root/model-cache/docling

# 2. Use --no-cache-dir to stop pip from saving downloaded .whl files
# 3. Force CPU-only PyTorch via --extra-index-url (Saves ~2.5GB+)
RUN pip install --upgrade pip --no-cache-dir && \
    pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch torchvision \
    docling==2.43.0 \
    transformers \
    sentence-transformers \
    llama-stack-client==0.4.2 \
    pymilvus \
    fire \
    requests \
    rapidocr-onnxruntime \
    rapidocr \
    onnxruntime

# 4. Combine model downloads into a single RUN layer to reduce intermediate container overhead
RUN docling-tools models download --output-dir /opt/app-root/model-cache/docling && \
    python -c "\
from transformers import AutoTokenizer; \
from sentence_transformers import SentenceTransformer; \
m='${EMBED_MODEL_ID}'; \
AutoTokenizer.from_pretrained(m); \
SentenceTransformer(m); \
print('cached', m)" && \
    python -c "\
from pathlib import Path; \
import numpy as np; \
from rapidocr import RapidOCR; \
root='/opt/app-root/model-cache/rapidocr'; \
Path(root).mkdir(parents=True, exist_ok=True); \
ocr=RapidOCR(params={'Global.model_root_dir': root}); \
ocr(np.zeros((64, 256, 3), dtype=np.uint8)); \
print('rapidocr cached', [str(p) for p in Path(root).rglob('*.onnx')])"

USER root

# 5. Clear out /tmp and user cache to catch any lingering extraction blobs
RUN chmod -R g+rwX /opt/app-root/model-cache \
    && rm -rf /tmp/* /var/tmp/* ~/.cache

USER 1001

ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1