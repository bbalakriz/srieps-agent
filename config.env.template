#!/bin/bash
# SREIPS Configuration File Template
# Copy this file to config.env and fill in your values
# Usage: cp config.env.template config.env && vim config.env

# ==============================================================================
# SREIPS Core Configuration
# ==============================================================================

# Slack Integration
# Get your Slack API key from https://api.slack.com/apps
export SLACK_API_KEY="xoxb-your-slack-bot-token-here"
export SLACK_CHANNEL="sreips-helper"
# Get your Slack Signing Secret from Basic Information -> App Credentials
export SIGNING_KEY="your-slack-signing-secret-here"

# OpenShift Cluster Name
export CLUSTER_NAME="openshift-prod"

# ==============================================================================
# MinIO Configuration
# ==============================================================================

# MinIO Root Credentials
# Username must be at least 3 characters, password at least 8 characters
export MINIO_ROOT_USER="minio"
export MINIO_ROOT_PASSWORD="***REMOVED***"

# ==============================================================================
# Red Hat API MCP Server Configuration
# ==============================================================================

# Red Hat API Offline Token
# Get your offline token from https://access.redhat.com/management/api
export RH_API_OFFLINE_TOKEN="your-rh-api-offline-token-here"

# ==============================================================================
# LlamaStack Configuration
# ==============================================================================

# Inference Model Configuration
export INFERENCE_MODEL="Qwen3.6-35B-A3B"
export VLLM_URL="https://litellm-litemaas.apps.prod.rhoai.rh-aiservices-bu.com/v1"
export VLLM_TLS_VERIFY="true"
export VLLM_API_TOKEN="sk-your-vllm-api-token-here"

# Note: Data Science Pipelines will use MINIO_ROOT_USER and MINIO_ROOT_PASSWORD 
# from the MinIO section above - no need to set separate credentials

# ==============================================================================
# Database Configuration for LlamaStack metadata and Milvus Vector Database
# ==============================================================================
# PostgreSQL Configuration for LlamaStack
export POSTGRES_DB_USER="your-postgres-user-here"
export POSTGRES_DB_PASSWORD="your-postgres-password-here"
export POSTGRES_DB_NAME="your-postgres-db-name-here"

# Milvus Vector Database Password (optional, defaults to MyStr0ngP@ssw0rd)
export MILVUS_PASSWORD="your-milvus-password-here"

# ==============================================================================
# Mattermost Configuration (Optional - Alternative to Slack)
# ==============================================================================

# set to true to deploy Mattermost and use it for SREIPS notifications
export MATTERMOST_ENABLED="true"

# MySQL credentials for the Mattermost database
# root password must be a strong password (min 8 characters)
export MATTERMOST_MYSQL_ROOT_PASSWORD="your-mattermost-mysql-root-password"
# password for the mattermost database user
export MATTERMOST_MYSQL_PASSWORD="your-mattermost-mysql-password"
export MATTERMOST_URL="http://mattermost-team-edition.mattermost.svc.cluster.local:8065"

# Mattermost channel where SREIPS will send notifications
export MATTERMOST_CHANNEL="sreips-helper"

# Bot token and token ID obtained from Mattermost after creating the bot account.
# These are filled in during the bootstrap pause - leave blank on first run.
# The bootstrap will prompt you to set these after Mattermost is deployed.
export MATTERMOST_BOT_TOKEN=""
export MATTERMOST_BOT_TOKEN_ID=""

# ==============================================================================
# Red Hat KCS MCP Server Configuration
# ==============================================================================

# KCS_MODE controls how the rh-kcs-mcp server answers KCS queries.
#   offline (default) - local Milvus store kcs_vector_id via LlamaStack RAG
#   online            - live access.redhat.com API; requires RH_API_OFFLINE_TOKEN at runtime
#
# Bootstrap applies this value when patching rh-kcs-mcp (with LLAMA_STACK_URL).
# Offline mode requires the kcs-exporter ingest job after bootstrap;
# see Readme.md "KCS offline ingest".
export KCS_MODE="offline"

# LLAMA_STACK_URL is set automatically on redhat-api-mcp during bootstrap
# (patch_rh_kcs_mcp_with_llamastack_url). Do not set it manually unless you
# are re-patching the deployment outside of bootstrap.

# ==============================================================================
# Hermes RCA (hermes-rhoai3.4 branch)
# ==============================================================================

# Hermes agent (bootstrap deploys hermes-all-in-one.yaml; HERMES_BASE_URL captured from route)
# used for hermes-api-secret and hermes-rca-bridge (must match)
export HERMES_API_KEY=""
export HERMES_MODEL="Qwen3.6-35B-A3B"
# OPENROUTER_APIKEY from optional section above feeds hermes-openrouter-secret

# sreips-runner HERMES_RCA_URL and USE_HERMES_RCA are set in sreips-core/sreips-setup.yaml

# ==============================================================================
# Vector DB / RAG MCP
# ==============================================================================

# Vector Database ID (used by sreips-rag-mcp; can be overridden with explicit UUID if needed)
export VECTOR_DB_ID="sreips_vector_id"

# Note: LLAMA_STACK_URL and MCP_ENDPOINT are automatically captured
# from OpenShift routes during installation and do not need to be set manually


